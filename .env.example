# ── Backend ──────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated origins allowed by CORS (production: https://ekown.github.io)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (CockroachDB compatible)
DATABASE_URL=postgresql://user:pass@localhost:5432/grocery_tracker

# AWS S3 (for receipt image storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ── Auth (future) ────────────────────────────

# Hardcoded user ID (auth is future work; used in dev)
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
